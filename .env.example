# Copy to .env (or server environment) and fill real values.
# Keep production secrets out of git.
#
# Runtime paths (recommended: keep under server-only outside deploy/web root)
# DENT_SERVER_ONLY_ROOT=server-only
# DENT_STORAGE_ROOT=server-only/storage
# DENT_SESSION_SAVE_PATH=server-only/sessions

DENT_AUTH_SECRET_KEY=

# SMS provider integration
DENT_SMS_FARAZ_ENABLED=false
DENT_SMS_FARAZ_API_KEY=
DENT_SMS_FARAZ_PATTERN_CODE=
DENT_SMS_FARAZ_SENDER_LINE=
DENT_SMS_FARAZ_DOMAIN=
DENT_SMS_FARAZ_CODE_PARAM=code
DENT_SITE_DOMAIN=

# Payment integration
# available: mock | zarinpal | zibal
DENT_PAYMENT_GATEWAY=mock
DENT_PAYMENT_ZARINPAL_MERCHANT_ID=
DENT_PAYMENT_ZARINPAL_REQUEST_URL=
DENT_PAYMENT_ZARINPAL_VERIFY_URL=
DENT_PAYMENT_ZARINPAL_START_URL=
DENT_PAYMENT_ZIBAL_MERCHANT=
DENT_PAYMENT_ZIBAL_TOKEN=
DENT_PAYMENT_ZIBAL_REQUEST_URL=
DENT_PAYMENT_ZIBAL_VERIFY_URL=
DENT_PAYMENT_ZIBAL_START_URL=
# optional webhook for owner notification integrations (sms/telegram/email bridge)
DENT_PAYMENT_NOTIFICATION_WEBHOOK=

# Chat media processing
DENT_CHAT_MEDIA_TARGET_MB=2
DENT_CHAT_FFMPEG_BIN=ffmpeg

# Navid integration
DENT_NAVID_SECRET_KEY=
DENT_NAVID_PYTHON_BIN=python

# ClassOps persistence. Prefer paths under DENT_STORAGE_ROOT/server-only.
# Leave empty to use storage/classops/store.json and storage/classops/domain-state.json.
DENT_CLASSOPS_STORE_PATH=
DENT_CLASSOPS_STAGE2_STATE_PATH=

# ClassOps delivery capability advertisement.
# These flags describe runtime availability; they do not contain chat/user IDs.
DENT_CLASSOPS_TELEGRAM_ENABLED=false
DENT_CLASSOPS_BALE_ENABLED=false
# Set only after Bale channel delivery is proven in the deployed runtime.
DENT_CLASSOPS_BALE_CHANNEL_SUPPORTED=false

# ClassOps AI Copilot (dedicated credential; never reuse Voice/STT keys).
# Provider currently supported by this release: avalai.
DENT_CLASSOPS_AI_PROVIDER=avalai
DENT_CLASSOPS_AI_BASE_URL=https://api.avalai.ir
DENT_CLASSOPS_AI_AVALAI_API_KEY=
DENT_CLASSOPS_AI_MODEL=
DENT_CLASSOPS_AI_TIMEOUT_MS=12000
# bounded transient retry count: 0..2
DENT_CLASSOPS_AI_MAX_RETRIES=1
# optional cost telemetry only; omit if rates are not configured.
DENT_CLASSOPS_AI_INPUT_USD_PER_MILLION=
DENT_CLASSOPS_AI_OUTPUT_USD_PER_MILLION=

# Deterministic ClassOps digest schedule in Asia/Tehran.
DENT_CLASSOPS_TOMORROW_SUMMARY_LOCAL_TIME=21:00
DENT_CLASSOPS_WEEKLY_DIGEST_LOCAL_TIME=20:00
