# IDE and editor files
.vscode
**/.vscode/sftp.json
.idea/
*.swp
*.swo
*~

# Local test/debug artifacts
.codex-local/
.codex_tmp/
.codex-tmp/
_remote_*

# Python caches
__pycache__/
**/__pycache__/
.pytest_cache/
.mypy_cache/

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
sftp.json
settings.json

# Runtime state (must never be versioned)
/storage/
/tmp/
/sessions/
/backups/
/secrets/
/server-only/*
!/server-only/.gitignore
!/server-only/README.md

# Config policy: examples only
/config/*
!/config/examples/
!/config/examples/**

# Runtime/temp outputs
*.pid
*.tmp
*.log
logs/
/bot_runtime/.codex-local/
/bot_runtime/backups/
/bot_runtime/output/
/bot_runtime/server-only/
/bot_runtime/storage/
/bot_runtime/tmp/
/bot_runtime/sessions/
/bot_runtime/**/*.db
/bot_runtime/**/*.sqlite*

# Dependency folders
node_modules/
vendor/
!/public_html/assets/vendor/
!/public_html/assets/vendor/pdfjs/
!/public_html/assets/vendor/pdfjs/6.2.108/
!/public_html/assets/vendor/pdfjs/6.2.108/LICENSE
!/public_html/assets/vendor/pdfjs/6.2.108/pdf.min.mjs
!/public_html/assets/vendor/pdfjs/6.2.108/pdf.worker.min.mjs

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini
