{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "classops-exam-ack-v1",
  "status": "candidate",
  "promotionRequired": true,
  "runtimeWiring": false,
  "baseContract": "classops-v1",
  "dependencies": [
    "classops-v1",
    "canonical-student-identity-v1",
    "notification-integration-v1"
  ],
  "sourceOfTruthBoundaries": {
    "operationalExam": "ClassOps item plus exam_ops_v1 extension",
    "assessmentAttemptAnswerTimerAccessPayment": "existing website assessment/payment subsystems",
    "notifications": "existing notification subsystem",
    "actorIdentity": "canonical studentNumber from existing auth/identity subsystem",
    "transportRouting": "existing Telegram/Bale identity and delivery stores"
  },
  "exam": {
    "extensionNamespace": "exam_ops_v1",
    "projectionVersion": "classops-exam-projection-v1",
    "reminderPolicyVersion": "classops-exam-reminder-v1",
    "foundationReminderPolicy": {
      "version": "classops-reminder-placeholder-v1",
      "rules": []
    },
    "defaultReminderPolicy": {
      "version": "classops-exam-reminder-v1",
      "enabled": true,
      "rules": [
        {
          "key": "t_minus_3d",
          "kind": "relative_before_start",
          "offsetSeconds": 259200
        },
        {
          "key": "t_minus_1d",
          "kind": "relative_before_start",
          "offsetSeconds": 86400
        },
        {
          "key": "night_before",
          "kind": "calendar_marker",
          "marker": "night_before"
        },
        {
          "key": "morning_of",
          "kind": "calendar_marker",
          "marker": "morning_of"
        }
      ]
    },
    "schedulerOwnsDueCalculation": true,
    "revisionSemantics": {
      "rescheduleRequiresExpectedRevision": true,
      "rescheduleRecordsSupersedesRevision": true,
      "cancelUsesFoundationLifecycle": true,
      "historyDestructiveRewriteAllowed": false
    },
    "referenceOnlyFields": [
      "reference",
      "assessmentRef",
      "resourceRefs",
      "paymentAccessRef"
    ],
    "forbiddenParallelStateFields": [
      "attempt",
      "attempts",
      "attemptState",
      "attemptsByUser",
      "answer",
      "answers",
      "answersByUser",
      "timer",
      "timerState",
      "access",
      "hasAccess",
      "payment",
      "payments",
      "paymentStatus",
      "paid",
      "verifiedPayment",
      "verifiedSuccess",
      "transaction",
      "transactions"
    ]
  },
  "criticalAck": {
    "recordVersion": "classops-critical-ack-record-v1",
    "stateVersion": "classops-critical-ack-state-v1",
    "projectionVersion": "classops-critical-ack-projection-v1",
    "eligibilityVersion": "classops-audience-eligibility-v1",
    "tuple": [
      "itemId",
      "revision",
      "studentNumber"
    ],
    "requiresExplicitUserIntent": true,
    "transportDeliveryOrReadReceiptIsAck": false,
    "exactRevisionRequired": true,
    "newRevisionRequiresNewAck": true,
    "audienceEligibilityRequired": true,
    "crossAudienceFailsClosed": true,
    "ownerAggregateFields": [
      "eligible",
      "acked",
      "pending"
    ],
    "auditContainsRawStudentNumber": false,
    "auditContainsRawIdempotencyKey": false
  },
  "apiCandidate": {
    "route": "POST /api/classops-ack/items/{itemId}/ack",
    "requestBody": {
      "revision": "positive integer",
      "idempotencyKey": "8..128 canonical characters",
      "intent": "explicit_user_ack"
    },
    "serverDerived": [
      "studentNumber",
      "ackedAt",
      "audience eligibility proof"
    ],
    "notYetWired": true
  },
  "storageCandidate": {
    "private": true,
    "runtimeOnly": true,
    "gitTrackedData": false,
    "requiredSemantics": [
      "exclusive lock for mutation",
      "atomic commit",
      "fail closed on malformed state",
      "idempotency conflict detection",
      "non-destructive ACK history"
    ],
    "notYetWired": true
  },
  "$defs": {
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "ref"
      ],
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        }
      }
    },
    "reminderRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "kind",
            "offsetSeconds"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,47}$"
            },
            "kind": {
              "const": "relative_before_start"
            },
            "offsetSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "kind",
            "marker"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,47}$"
            },
            "kind": {
              "const": "calendar_marker"
            },
            "marker": {
              "enum": [
                "night_before",
                "morning_of"
              ]
            }
          }
        }
      ]
    },
    "reminderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "rules"
      ],
      "properties": {
        "version": {
          "const": "classops-exam-reminder-v1"
        },
        "enabled": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/reminderRule"
          }
        }
      }
    },
    "paymentAccessReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "ref",
        "mode"
      ],
      "properties": {
        "system": {
          "enum": [
            "website_assessment_access",
            "payments_store"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "mode": {
          "const": "reference_only"
        }
      }
    },
    "examExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "reference",
        "scope",
        "notes",
        "reminderPolicy",
        "assessmentRef",
        "resourceRefs",
        "paymentAccessRef",
        "lastScheduleChange"
      ],
      "properties": {
        "contractVersion": {
          "const": "classops-exam-ack-v1"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/externalReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "type": "string",
          "maxLength": 3000
        },
        "notes": {
          "type": "string",
          "maxLength": 6000
        },
        "reminderPolicy": {
          "$ref": "#/$defs/reminderPolicy"
        },
        "assessmentRef": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "system",
                "ref"
              ],
              "properties": {
                "system": {
                  "const": "website_assessment"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "resourceRefs": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{1,47}$"
              },
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
              }
            }
          }
        },
        "paymentAccessRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/paymentAccessReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastScheduleChange": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "supersedesRevision"
              ],
              "properties": {
                "kind": {
                  "const": "rescheduled"
                },
                "supersedesRevision": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ackRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "ackId",
        "itemId",
        "revision",
        "studentNumber",
        "ackedAt",
        "idempotencyKey",
        "intent"
      ],
      "properties": {
        "contractVersion": {
          "const": "classops-critical-ack-record-v1"
        },
        "ackId": {
          "type": "string",
          "pattern": "^ack_[a-f0-9]{24}$"
        },
        "itemId": {
          "type": "string",
          "pattern": "^cop_[a-f0-9]{16,64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "studentNumber": {
          "type": "string",
          "pattern": "^[0-9]{4,32}$"
        },
        "ackedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "intent": {
          "const": "explicit_user_ack"
        }
      }
    },
    "eligibilityProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "itemId",
        "revision",
        "studentNumber",
        "eligible",
        "audienceFingerprint"
      ],
      "properties": {
        "contractVersion": {
          "const": "classops-audience-eligibility-v1"
        },
        "itemId": {
          "type": "string",
          "pattern": "^cop_[a-f0-9]{16,64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "studentNumber": {
          "type": "string",
          "pattern": "^[0-9]{4,32}$"
        },
        "eligible": {
          "type": "boolean"
        },
        "audienceFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "ownerAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "revision",
        "eligible",
        "acked",
        "pending"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^cop_[a-f0-9]{16,64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "acked": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
