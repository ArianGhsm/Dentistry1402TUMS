/var/log/nginx/dentistry1402.access.log /var/log/nginx/dentistry1402.error.log /var/log/php8.3-fpm-dentistry1402.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    su root adm
    create 0640 www-data adm
    sharedscripts
    postrotate
        systemctl reload nginx >/dev/null 2>&1 || true
        systemctl reload php8.3-fpm >/dev/null 2>&1 || true
    endscript
}
