[Unit]
Description=Hamiad session keep-alive and assignment check for Dentistry1402 owner

[Timer]
# Every 10 minutes: keeps the Moodle session from idling out so the CAPTCHA
# login is rarely needed. Reminders still run only in their 08/14/20 Tehran
# slots (tracked in storage by the CLI).
OnBootSec=2min
OnCalendar=*:0/10
Persistent=true
RandomizedDelaySec=45s
AccuracySec=30s
Unit=dentistry1402-hamiad-reminders.service

[Install]
WantedBy=timers.target
