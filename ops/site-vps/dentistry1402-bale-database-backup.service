[Unit]
Description=Verified Dentistry1402 database backup to the configured Bale owner
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/integrated-dent/bale-bot.env
ExecStart=/usr/local/lib/dentistry1402/send-bale-database-backup
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/backups/dentistry1402/runtime /etc/integrated-dent
ReadWritePaths=/var/backups/dentistry1402/bale-database
ExecStopPost=/usr/bin/systemctl start dentistry1402-backup-retention.service
